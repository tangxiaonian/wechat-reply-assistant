# Root allowlist: local validation assets stay private by default.
/*
!/.gitignore
!/.nvmrc
!/AGENTS.md
!/README.md
!/CHANGELOG.md
!/package.json
!/package-lock.json
!/rust-toolchain.toml
!/打开回声.command
!/docs/
!/frontend/
!/src-tauri/
!/shared/
!/scripts/
!/.github/

# Never track runtime data, credentials, logs or compiled bundles.
node_modules/
dist/
target/
gen/
output/
logs/
.local-only/
.playwright-cli/
.DS_Store
.env
.env.*
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.log
*.pem
*.key
*.p12
*.pfx
*.mobileprovision
